Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 35; 40
    Fixed Frame: odom
    Frame Rate: 15
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
    - Class: rviz_default_plugins/TF
      Name: Frames
      Enabled: true
    - Class: rviz_default_plugins/LaserScan
      Name: Lidar
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 5
      Size (m): 0.03
      Style: Points
    - Class: rviz_default_plugins/Image
      Name: Camera
      Enabled: true
      Topic:
        Value: /camera/image_raw
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 5
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 8
      Pitch: 0.8
      Yaw: 0.7
      Focal Point:
        X: 0
        Y: 0
        Z: 0
Window Geometry:
  Width: 700
  Height: 550
  X: 570
  Y: 0
